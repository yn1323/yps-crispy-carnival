{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!build",
      "!.scaffdog",
      "!convex/_generated",
      "!.claude",
      "!.codex",
      "!src/routeTree.gen.ts",
      "index.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "complexity": {
        "noForEach": "off"
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.stories.ts",
        "!src/**/*.stories.tsx",
        "!src/components/ui/FormControls/index.tsx",
        "!src/components/ui/Select/index.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "input": "入力欄は @/src/components/ui/FormControls を使用してください。",
                  "textarea": "入力欄は @/src/components/ui/FormControls を使用してください。",
                  "select": "入力欄は @/src/components/ui/FormControls を使用してください。"
                }
              }
            }
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@chakra-ui/react": {
                    "importNames": [
                      "Input",
                      "Textarea",
                      "NativeSelect",
                      "NativeSelectField",
                      "Select",
                      "SelectHiddenSelect"
                    ],
                    "message": "@/src/components/ui/FormControls または @/src/components/ui/Select を使用してください。"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
